{
	"tasks": {
		"dev": "deno run -A --node-modules-dir npm:vite dev",
		"build": "deno run -A --node-modules-dir npm:vite build",
		"serve": "deno run -A --node-modules-dir npm:vite preview"
	},
	"imports": {
		"@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.0",
		"@openbible/bsb": "jsr:@openbible/bsb@0.1.32",
		"@openbible/core": "jsr:@openbible/core@^0.1.19",
		"@preact/preset-vite": "npm:@preact/preset-vite@^2.9.1",
		"@preact/signals": "npm:@preact/signals@^1.3.0",
		"preact": "npm:preact@^10.24.3",
		"simple-worker-vite": "npm:simple-worker-vite@^0.3.0",
		"tinybase": "npm:tinybase@^5.3.5",
		"vite": "npm:vite@^5.4.9"
	},
	"fmt": {
		"useTabs": true,
		"exclude": ["dist", ".vite"]
	},
	"compilerOptions": {
		"lib": ["dom", "esnext", "WebWorker", "dom.iterable"],
		"jsx": "react-jsx",
		"jsxImportSource": "preact"
	}
}
