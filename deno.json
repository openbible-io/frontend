{
	"tasks": {
		"build": "deno -A ./build/index.ts",
		"dev": "deno task build --dev"
	},
	"imports": {
		"@std/media-types": "jsr:@std/media-types@^1.0.3",
		"autoprefixer": "npm:autoprefixer@^10.4.20",
		"fancy-ansi": "npm:fancy-ansi@^0.1.3",
		"filesize": "npm:filesize@^10.1.6",
		"html5parser": "npm:html5parser@^2.0.2",
		"markdown-table": "npm:markdown-table@^3.0.4",
		"postcss": "npm:postcss@^8.4.47",
		"preact": "npm:preact@^10.24.3",
		"preact-iso": "npm:preact-iso@^2.8.1",
		"preact-render-to-string": "npm:preact-render-to-string@^6.5.11",
		"prosemirror-commands": "npm:prosemirror-commands@^1.6.2",
		"prosemirror-history": "npm:prosemirror-history@^1.4.1",
		"prosemirror-keymap": "npm:prosemirror-keymap@^1.2.2",
		"prosemirror-model": "npm:prosemirror-model@^1.23.0",
		"prosemirror-state": "npm:prosemirror-state@^1.4.3",
		"prosemirror-view": "npm:prosemirror-view@^1.35.0",
		"rolldown": "npm:rolldown@0.14.0-snapshot-d5e797b-20241114003621",
		"sharp": "npm:sharp@^0.33.5",
		"tailwindcss": "npm:tailwindcss@^3.4.14",
		"tinybase": "npm:tinybase@^5.3.5"
	},
	"fmt": {
		"useTabs": true,
		"exclude": ["dist"]
	},
	"compilerOptions": {
		"lib": [
			"dom",
			"dom.iterable",
			"dom.asynciterable",
			"webworker",
			"deno.ns",
			"node"
		],
		"jsx": "react-jsx",
		"jsxImportSource": "preact"
	},
	"nodeModulesDir": "auto"
}
